{
  "projector": {
    "firstMatchingProjector": {
      "attributeRules": [
        {
          "projector": {
            "attributeProjector": {
              "attributeKey": "http.url",
              "attributeRule": {
                "projector": {
                  "regexCaptureGroupProjector": {
                    "regexCaptureGroup": "host.com\/(.*)\/.*",
                    "attributeRule": {
                      "initialActions": [
                        {
                          "attributeAddition": {
                            "attributeKey": "traceableai.service.name",
                            "valueProjectionRule": {
                              "projector": {
                                "noOpProjector": {}
                              }
                            }
                          }
                        },
                        {
                          "attributeAddition": {
                            "attributeKey": "traceableai.servicenaming.rule",
                            "valueProjectionRule": {
                              "projector": {
                                "valueProjector": {
                                  "value": "dynamic-naming-rule-id"
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}