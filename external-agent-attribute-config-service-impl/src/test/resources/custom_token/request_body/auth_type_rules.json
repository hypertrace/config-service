{
  "attributeRules": [
    {
      "projector": {
        "attributeProjector": {
          "attributeKey": "http.request.body",
          "attributeRule": {
            "projector": {
              "jsonProjector": {
                "jsonPathRules": [
                  {
                    "key": "$.my-path",
                    "attributeRule": {
                      "initialActions": [
                        {
                          "attributeArrayAppend": {
                            "attributeKey": "traceableai.auth.types",
                            "valueProjectionRule": {
                              "projector": {
                                "valueProjector": {
                                  "value": "custom-auth"
                                }
                              }
                            }
                          }
                        },
                        {
                          "attributeArrayAppend": {
                            "attributeKey": "traceableai.auth.rules",
                            "valueProjectionRule": {
                              "projector": {
                                "valueProjector": {
                                  "value": "custom-token-rule-id"
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "projector": {
        "attributeProjector": {
          "attributeKey": "rpc.request.body",
          "attributeRule": {
            "projector": {
              "jsonProjector": {
                "jsonPathRules": [
                  {
                    "key": "$.my-path",
                    "attributeRule": {
                      "initialActions": [
                        {
                          "attributeArrayAppend": {
                            "attributeKey": "traceableai.auth.types",
                            "valueProjectionRule": {
                              "projector": {
                                "valueProjector": {
                                  "value": "custom-auth"
                                }
                              }
                            }
                          }
                        },
                        {
                          "attributeArrayAppend": {
                            "attributeKey": "traceableai.auth.rules",
                            "valueProjectionRule": {
                              "projector": {
                                "valueProjector": {
                                  "value": "custom-token-rule-id"
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}