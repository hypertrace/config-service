{
  "attributeRules": [
    {
      "projector": {
        "attributeProjector": {
          "attributeKey": "http.request.header.cookie",
          "attributeRule": {
            "projector": {
              "cookieProjector": {
                "cookieNameRule": {
                  "key": "my-cookie",
                  "attributeRule": {
                    "initialActions": [
                      {
                        "attributeArrayAppend": {
                          "attributeKey": "traceableai.auth.types",
                          "valueProjectionRule": {
                            "projector": {
                              "valueProjector": {
                                "value": "custom-auth"
                              }
                            }
                          }
                        }
                      },
                      {
                        "attributeArrayAppend": {
                          "attributeKey": "traceableai.auth.rules",
                          "valueProjectionRule": {
                            "projector": {
                              "valueProjector": {
                                "value": "custom-token-rule-id"
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
