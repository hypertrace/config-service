                "attributeRule": {
                  "projector": {
                    "base64Projector": {
                      "attributeRule": {
                        "projector": {
                          "regexCaptureGroupProjector": {
                            "regexCaptureGroup": "^([^:]+):?",
                            "attributeRule": {
                              "initialActions": [
