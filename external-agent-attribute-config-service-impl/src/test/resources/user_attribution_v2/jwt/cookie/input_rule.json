{
  "id": "jwt-cookie-rule-id",
  "data": {
    "name": "Jwt Auth",
    "scope": {
      "environmentScope": {
        "environmentNames": {
          "values": [
            "test-env"
          ]
        }
      }
    },
    "rootTokenRule": {
      "attributeProjection": {
        "attribute": {
          "requestCookie": {
            "operator": "KEY_MATCH_OPERATOR_EQUALS",
            "matchKey": "jwt"
          }
        },
        "valueProjections": [
          {
            "regexCaptureGroup": {
              "regex": "^(?:(?i)Bearer:? )?(.*)$"
            }
          }
        ]
      }
    },
    "userIdRule": {
      "rootRelativeProjection": {
        "valueProjections": [
          {
            "jwtPayloadClaim": {
              "claimKey": "sub"
            }
          },
          {
            "jsonPath": {
              "path": "user.id"
            }
          }
        ]
      }
    },
    "userRoleRule": {
      "rootRelativeProjection": {
        "valueProjections": [
          {
            "jwtPayloadClaim": {
              "claimKey": "sub"
            }
          },
          {
            "jsonPath": {
              "path": "user.role"
            }
          }
        ]
      }
    },
    "userScopeRule": {
      "rootRelativeProjection": {
        "valueProjections": [
          {
            "jwtPayloadClaim": {
              "claimKey": "sub"
            }
          },
          {
            "jsonPath": {
              "path": "user.scope"
            }
          }
        ]
      }
    },
    "authTypeRule": {
      "literalValueProjection": {
        "literalValue": {
          "stringValue": "OAuth 2.0"
        }
      }
    },
    "custom_token_rules": {
      "audience": {
        "rootRelativeProjection": {
          "valueProjections": [
            {
              "jwtPayloadClaim": {
                "claimKey": "aud"
              }
            }
          ]
        }
      }
    },
    "template": "TEMPLATE_JWT"
  },
  "rank": 2
}