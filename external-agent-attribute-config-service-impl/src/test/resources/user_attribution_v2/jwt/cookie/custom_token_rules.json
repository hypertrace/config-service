{
  "attributeRules": [
    {
      "projector": {
        "attributeProjector": {
          "attributeKey": "http.request.header.cookie",
          "attributeRule": {
            "projector": {
              "cookieProjector": {
                "cookieNameRule": {
                  "key": "jwt",
                  "attributeRule": {
                    "projector": {
                      "regexCaptureGroupProjector": {
                        "regexCaptureGroup": "^(?:(?i)Bearer:? )?(.*)$",
                        "attributeRule": {
                          "projector": {
                            "jwtProjector": {
                              "claimRule": {
                                "key": "aud",
                                "attributeRule": {
                                  "initialActions": [{
                                    "attributeAddition": {
                                      "attributeKey": "traceableai.custom.attribute.audience",
                                      "valueProjectionRule": {
                                        "projector": {
                                          "noOpProjector": {
                                          }
                                        }
                                      }
                                    }
                                  }, {
                                    "attributeAddition": {
                                      "attributeKey": "traceableai.custom.attribute.audience.rule",
                                      "valueProjectionRule": {
                                        "projector": {
                                          "valueProjector": {
                                            "value": "jwt-cookie-rule-id"
                                          }
                                        }
                                      }
                                    }
                                  }]
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
