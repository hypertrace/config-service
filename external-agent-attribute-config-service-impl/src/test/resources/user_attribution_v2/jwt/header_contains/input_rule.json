{
  "id": "jwt-header-rule-id",
  "data": {
    "name": "Jwt Auth",
    "scope": {
      "environmentScope": {
        "environmentNames": {
          "values": [
            "test-env"
          ]
        }
      }
    },
    "rootTokenRule": {
      "attributeProjection": {
        "attribute": {
          "requestHeader": {
            "operator": "KEY_MATCH_OPERATOR_CONTAINS",
            "matchKey": "authorization"
          }
        },
        "valueProjections": [
          {
            "regexCaptureGroup": {
              "regex": "^(?:(?i)Bearer:? )?(.*)$"
            }
          }
        ]
      }
    },
    "userIdRule": {
      "rootRelativeProjection": {
        "valueProjections": [
          {
            "jwtPayloadClaim": {
              "claimKey": "sub"
            }
          },
          {
            "jsonPath": {
              "path": "$.user.id"
            }
          }
        ]
      }
    },
    "userRoleRule": {
      "rootRelativeProjection": {
        "valueProjections": [
          {
            "jwtPayloadClaim": {
              "claimKey": "sub"
            }
          },
          {
            "jsonPath": {
              "path": "$.user.role"
            }
          }
        ]
      }
    },
    "authTypeRule": {
      "literalValueProjection": {
        "literalValue": {
          "stringValue": "OAuth 2.0"
        }
      }
    },
    "template": "TEMPLATE_JWT"
  },
  "rank": 2
}