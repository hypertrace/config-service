{
  "id": "jwt-header-rule-id",
  "data": {
    "jwtData": {
      "userIdClaim": "data-claim",
      "userIdLocation": {
        "jsonPath": "$.id",
        "parsingTarget": {
          "regex_capture_group": "user id is (.*)"
        }
      },
      "roleClaim": "data-claim",
      "roleLocation": {
        "jsonPath": "$.role",
        "parsingTarget": {
          "regex_capture_group": "user role is (.*)"
        }
      },
      "authentication": {
        "type": "JWT authentication"
      }
    }
  }
}