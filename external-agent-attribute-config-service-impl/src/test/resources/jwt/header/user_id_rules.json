{
  "attributeRules": [
    {
      "projector": {
        "attributeProjector": {
          "attributeKey": "http.request.header.authorization",
          "attributeRule": {
            "projector": {
              "regexCaptureGroupProjector": {
                "regexCaptureGroup": "^((?i)Bearer:? )?(.*)$",
                "attributeRule": {
                  "projector": {
                    "jwtProjector": {
                      "claimRules": [
                        {
                          "key": "data-claim",
                          "attributeRule": {
                            "projector": {
                              "jsonProjector": {
                                "jsonPathRules": [
                                  {
                                    "key": "$.id",
                                    "attributeRule": {
                                      "projector": {
                                        "regexCaptureGroupProjector": {
                                          "regexCaptureGroup": "user id is (.*)",
                                          "attributeRule": {
                                            "initialActions": [
                                              {
                                                "attributeAddition": {
                                                  "attributeKey": "enduser.id",
                                                  "valueProjectionRule": {
                                                    "projector": {
                                                      "noOpProjector": {
                                                      }
                                                    }
                                                  }
                                                }
                                              },
                                              {
                                                "attributeAddition": {
                                                  "attributeKey": "enduser.id.rule",
                                                  "valueProjectionRule": {
                                                    "projector": {
                                                      "valueProjector": {
                                                        "value": "jwt-header-rule-id"
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            ]
                                          }
                                        }
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "projector": {
        "attributeProjector": {
          "attributeKey": "rpc.request.metadata.authorization",
          "attributeRule": {
            "projector": {
              "regexCaptureGroupProjector": {
                "regexCaptureGroup": "^((?i)Bearer:? )?(.*)$",
                "attributeRule": {
                  "projector": {
                    "jwtProjector": {
                      "claimRules": [
                        {
                          "key": "data-claim",
                          "attributeRule": {
                            "projector": {
                              "jsonProjector": {
                                "jsonPathRules": [
                                  {
                                    "key": "$.id",
                                    "attributeRule": {
                                      "projector": {
                                        "regexCaptureGroupProjector": {
                                          "regexCaptureGroup": "user id is (.*)",
                                          "attributeRule": {
                                            "initialActions": [
                                              {
                                                "attributeAddition": {
                                                  "attributeKey": "enduser.id",
                                                  "valueProjectionRule": {
                                                    "projector": {
                                                      "noOpProjector": {
                                                      }
                                                    }
                                                  }
                                                }
                                              },
                                              {
                                                "attributeAddition": {
                                                  "attributeKey": "enduser.id.rule",
                                                  "valueProjectionRule": {
                                                    "projector": {
                                                      "valueProjector": {
                                                        "value": "jwt-header-rule-id"
                                                      }
                                                    }
                                                  }
                                                }
                                              }
                                            ]
                                          }
                                        }
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
