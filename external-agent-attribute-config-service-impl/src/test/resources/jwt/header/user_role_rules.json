{
  "attributeRules": [
    {
      "projector": {
        "attributeProjector": {
          "attributeKey": "http.request.header.authorization",
          "attributeRule": {
            "projector": {
              "regexCaptureGroupProjector": {
                "regexCaptureGroup": "^((?i)Bearer:? )?(.*)$",
                "attributeRule": {
                  "projector": {
                    "jwtProjector": {
                      "claimRule": {
                        "key": "data-claim",
                        "attributeRule": {
                          "projector": {
                            "jsonProjector": {
                              "jsonPathRule": {
                                "key": "$.role",
                                "attributeRule": {
                                  "projector": {
                                    "regexCaptureGroupProjector": {
                                      "regexCaptureGroup": "user role is (.*)",
                                      "attributeRule": {
                                        "initialActions": [
                                          {
                                            "attributeAddition": {
                                              "attributeKey": "enduser.role",
                                              "valueProjectionRule": {
                                                "projector": {
                                                  "noOpProjector": {
                                                  }
                                                }
                                              }
                                            }
                                          },
                                          {
                                            "attributeAddition": {
                                              "attributeKey": "enduser.role.rule",
                                              "valueProjectionRule": {
                                                "projector": {
                                                  "valueProjector": {
                                                    "value": "jwt-header-rule-id"
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        ]
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "projector": {
        "attributeProjector": {
          "attributeKey": "rpc.request.metadata.authorization",
          "attributeRule": {
            "projector": {
              "regexCaptureGroupProjector": {
                "regexCaptureGroup": "^((?i)Bearer:? )?(.*)$",
                "attributeRule": {
                  "projector": {
                    "jwtProjector": {
                      "claimRule": {
                        "key": "data-claim",
                        "attributeRule": {
                          "projector": {
                            "jsonProjector": {
                              "jsonPathRule": {
                                "key": "$.role",
                                "attributeRule": {
                                  "projector": {
                                    "regexCaptureGroupProjector": {
                                      "regexCaptureGroup": "user role is (.*)",
                                      "attributeRule": {
                                        "initialActions": [
                                          {
                                            "attributeAddition": {
                                              "attributeKey": "enduser.role",
                                              "valueProjectionRule": {
                                                "projector": {
                                                  "noOpProjector": {
                                                  }
                                                }
                                              }
                                            }
                                          },
                                          {
                                            "attributeAddition": {
                                              "attributeKey": "enduser.role.rule",
                                              "valueProjectionRule": {
                                                "projector": {
                                                  "valueProjector": {
                                                    "value": "jwt-header-rule-id"
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        ]
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
