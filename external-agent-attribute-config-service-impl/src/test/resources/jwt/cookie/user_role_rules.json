{
  "attributeRules": [
    {
      "projector": {
        "attributeProjector": {
          "attributeKey": "http.request.header.cookie",
          "attributeRule": {
            "projector": {
              "cookieProjector": {
                "cookieNameRule": {
                  "key": "jwt",
                  "attributeRule": {
                    "projector": {
                      "regexCaptureGroupProjector": {
                        "regexCaptureGroup": "Bearer-xyz (.*)",
                        "attributeRule": {
                          "projector": {
                            "jwtProjector": {
                              "claimRule": {
                                "key": "data-claim",
                                "attributeRule": {
                                  "projector": {
                                    "jsonProjector": {
                                      "jsonPathRule": {
                                        "key": "$.role",
                                        "attributeRule": {
                                          "projector": {
                                            "regexCaptureGroupProjector": {
                                              "regexCaptureGroup": "user role is (.*)",
                                              "attributeRule": {
                                                "initialActions": [
                                                  {
                                                    "attributeAddition": {
                                                      "attributeKey": "enduser.role",
                                                      "valueProjectionRule": {
                                                        "projector": {
                                                          "noOpProjector": {
                                                          }
                                                        }
                                                      }
                                                    }
                                                  },
                                                  {
                                                    "attributeAddition": {
                                                      "attributeKey": "enduser.role.rule",
                                                      "valueProjectionRule": {
                                                        "projector": {
                                                          "valueProjector": {
                                                            "value": "jwt-cookie-rule-id"
                                                          }
                                                        }
                                                      }
                                                    }
                                                  }
                                                ]
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
