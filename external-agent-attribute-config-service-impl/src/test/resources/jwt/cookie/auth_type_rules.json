{
  "attributeRules": [
    {
      "projector": {
        "attributeProjector": {
          "attributeKey": "http.request.header.cookie",
          "attributeRule": {
            "projector": {
              "cookieProjector": {
                "cookieNameRules": [
                  {
                    "key": "jwt",
                    "attributeRule": {
                      "projector": {
                        "regexCaptureGroupProjector": {
                          "regexCaptureGroup": "Bearer-xyz (.*)",
                          "attributeRule": {
                            "projector": {
                              "jwtProjector": {
                              }
                            },
                            "beforeChildrenActions": [
                              {
                                "attributeArrayAppend": {
                                  "attributeKey": "traceableai.auth.types",
                                  "valueProjectionRule": {
                                    "projector": {
                                      "valueProjector": {
                                        "value": "JWT authentication"
                                      }
                                    }
                                  }
                                }
                              },
                              {
                                "attributeArrayAppend": {
                                  "attributeKey": "traceableai.auth.rules",
                                  "valueProjectionRule": {
                                    "projector": {
                                      "valueProjector": {
                                        "value": "jwt-cookie-rule-id"
                                      }
                                    }
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}