{
  "attributeRules": [
    {
      "projector": {
        "attributeProjector": {
          "attributeKey": "http.request.header.cookie",
          "attributeRule": {
            "projector": {
              "cookieProjector": {
                "cookieNameRules": [
                  {
                    "key": "jwt",
                    "attributeRule": {
                      "projector": {
                        "regexCaptureGroupProjector": {
                          "regexCaptureGroup": "Bearer-xyz (.*)",
                          "attributeRule": {
                            "projector": {
                              "jwtProjector": {
                                "claimRules": [
                                  {
                                    "key": "data-claim",
                                    "attributeRule": {
                                      "projector": {
                                        "jsonProjector": {
                                          "jsonPathRules": [
                                            {
                                              "key": "$.id",
                                              "attributeRule": {
                                                "projector": {
                                                  "regexCaptureGroupProjector": {
                                                    "regexCaptureGroup": "user id is (.*)",
                                                    "attributeRule": {
                                                      "initialActions": [
                                                        {
                                                          "attributeAddition": {
                                                            "attributeKey": "enduser.id",
                                                            "valueProjectionRule": {
                                                              "projector": {
                                                                "noOpProjector": {
                                                                }
                                                              }
                                                            }
                                                          }
                                                        },
                                                        {
                                                          "attributeAddition": {
                                                            "attributeKey": "enduser.id.rule",
                                                            "valueProjectionRule": {
                                                              "projector": {
                                                                "valueProjector": {
                                                                  "value": "jwt-cookie-rule-id"
                                                                }
                                                              }
                                                            }
                                                          }
                                                        }
                                                      ]
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          ]
                                        }
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}