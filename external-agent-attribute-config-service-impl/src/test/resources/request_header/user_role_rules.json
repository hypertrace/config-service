{
  "attributeRules": [
    {
      "projector": {
        "attributeProjector": {
          "attributeKey": "http.request.header.role-hdr",
          "attributeRule": {
            "projector": {
              "regexCaptureGroupProjector": {
                "regexCaptureGroup": "user role is (.*)",
                "attributeRule": {
                  "initialActions": [
                    {
                      "attributeAddition": {
                        "attributeKey": "enduser.role",
                        "valueProjectionRule": {
                          "projector": {
                            "noOpProjector": {
                            }
                          }
                        }
                      }
                    },
                    {
                      "attributeAddition": {
                        "attributeKey": "enduser.role.rule",
                        "valueProjectionRule": {
                          "projector": {
                            "valueProjector": {
                              "value": "request-header-rule-id"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
