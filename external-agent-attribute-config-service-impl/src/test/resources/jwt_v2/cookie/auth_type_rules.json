{
  "attributeRules": [
    {
      "projector": {
        "attributeProjector": {
          "attributeKey": "http.request.header.cookie",
          "attributeRule": {
            "projector": {
              "cookieProjector": {
                "cookieNameRule": {
                  "key": "jwt",
                  "attributeRule": {
                    "projector": {
                      "regexCaptureGroupProjector": {
                        "regexCaptureGroup": "^(?:(?i)Bearer:? )?(.*)$",
                        "attributeRule": {
                          "projector": {
                            "valueProjector": {
                              "value": "OAuth 2.0",
                              "attributeRule": {
                                "initialActions": [{
                                  "attributeAddition": {
                                    "attributeKey": "traceableai.auth.types",
                                    "valueProjectionRule": {
                                      "projector": {
                                        "noOpProjector": {
                                        }
                                      }
                                    }
                                  }
                                }, {
                                  "attributeAddition": {
                                    "attributeKey": "traceableai.auth.rules",
                                    "valueProjectionRule": {
                                      "projector": {
                                        "valueProjector": {
                                          "value": "jwt-cookie-rule-id"
                                        }
                                      }
                                    }
                                  }
                                }]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}