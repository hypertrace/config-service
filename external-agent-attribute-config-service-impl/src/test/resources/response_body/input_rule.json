{
  "id": "response-body-rule-id",
  "data": {
    "responseBodyData": {
      "userIdLocation": {
        "jsonPath": "$.id",
        "parsingTarget": {
          "regex_capture_group": "user id is (.*)"
        }
      },
      "roleLocation": {
        "jsonPath": "$.role",
        "parsingTarget": {
          "regex_capture_group": "user role is (.*)"
        }
      },
      "authentication": {
        "type": "some-body-based-auth"
      }
    }
  }
}