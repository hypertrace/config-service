                                        "valueProjectionRule": {
                                          "projector": {
                                            "valueProjector": {
                                              "value": "HMAC"
                                            }
                                          }
                                        }
                                      }
                                    },
                                    {
                                      "attributeArrayAppend": {
                                        "attributeKey": "traceableai.auth.rules",
                                        "valueProjectionRule": {
                                          "projector": {
                                            "valueProjector": {
                                              "value": "Standard-HMAC-System-Rule"
                                            }
                                          }
                                        }
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          }
                        }
                      }
