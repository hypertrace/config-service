    {
      "id": "__default__traceable_session_cookie_validation_eds_rule_copy",
      "name": "Traceable Session Cookie Validation",
      "version": "0",
      "rule_scope": {
        "scope_conditions": [
          {
            "match_condition_scope": {
              "generic_match_condition": {
                "jexl_expression": {
                  "jexl_expression": "($s.getUrl().startsWith('https://appmini.tracevault.link/') || $s.getUrl().startsWith('https://app4.tracevault.link/')) && !($s.getPath().endsWith('/user_new.php') || $s.getPath().endsWith('/login.php') || $s.getPath().endsWith('/login') || $s.getPath().endsWith('/forgot-password') || $s.getPath() == '/')"
                }
              },
              "negate": false
            }
          },
          {
            "http_method_scope": {
              "http_methods": [
                "GET",
                "POST",
                "PUT",
                "DELETE"
              ]
            }
          }
        ]
      },
      "rule_category": "EDGE_DECISION_RULE_CATEGORY_CUSTOM_SIGNATURE",
      "rule_status": {
        "disabled": false,
        "internal": false
      },
      "rule_definition": {
        "edge_input_kind": "EDGE_INPUT_KIND_HTTP_REQUEST",
        "rule_variables": [
          {
            "name": "traceable_session_cookie",
            "rules": [
              {
                "transformation_config": {
                  "jexl_expression": {
                    "jexl_expression": "$s.getTraceableSessionCookie()"
                  },
                  "output_type": "FIELD_TYPE_UNSPECIFIED"
                },
                "transformation_configs": []
              }
            ]
          }
        ],
        "attribute_projections": [],
        "signature_rule": {
          "match_condition": {
            "generic_match_condition": {
              "jexl_expression": {
                "jexl_expression": "traceable_session_cookie == null || !(traceable_session_cookie.isValid()) || (traceable_session_cookie.getDecodedPayload()['state'] == null) || (!(traceable_session_cookie.getDecodedPayload()['state'].asText().equals('INVISIBLE_PASS')) && !((traceable_session_cookie.getDecodedPayload()['state'].asText().equals('VISUAL_PASS')))) || !(jwt:verifyTraceableSessionSignature(traceable_session_cookie, traceable_session_cookie.getDecodedPayload()['siteKey'].asText()))"
              }
            },
            "negate": false
          }
        },
        "custom_fields": {}
      },
      "rule_decision": {
        "edge_decision_type": "EDGE_DECISION_TYPE_ALERT",
        "decorations": [],
        "threat_type": "Bot Risk",
        "span_attributes": [
          {
            "span_attribute_key": {
              "static_value": "traceableai_is_bot",
              "output_type": "FIELD_TYPE_UNSPECIFIED"
            },
            "span_attribute_value": {
              "static_value": "true",
              "output_type": "FIELD_TYPE_UNSPECIFIED"
            }
          }
        ],
        "edge_decision_targets": [],
        "rule_info_decorations": []
      },
      "policy_kind": "POLICY_KIND_BOT_MITIGATION",
      "description": "Default rule to be applied on EDS for all APIs, to validate that traceable-session is present and valid",
      "template_id": "__default__traceable_session_cookie_validation_eds_rule"
    },
