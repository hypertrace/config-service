    {
      "id": "api_access_validate_fp",
      "name": "Verify browser access",
      "version": "0",
      "rule_scope": {
        "scope_conditions": [
          {
            "match_condition_scope": {
              "generic_match_condition": {
                "jexl_expression": {
                  "jexl_expression": "$s.getPath().contains('/validate-fp') || $s.getUrl().startsWith('https://appmini.tracevault.link/') || $s.getUrl().startsWith('https://app4.tracevault.link/')"
                }
              },
              "negate": false
            }
          }
        ]
      },
      "rule_category": "EDGE_DECISION_RULE_CATEGORY_ORIGINAL",
      "rule_status": {
        "disabled": false,
        "internal": false
      },
      "rule_definition": {
        "edge_input_kind": "EDGE_INPUT_KIND_HTTP_REQUEST",
        "rule_variables": [],
        "attribute_projections": [],
        "access_pattern_rule": {
          "correlation_key": {
            "attributes": [
              {
                "name": "ip_address",
                "type": "FIELD_TYPE_STR",
                "rules": [
                  {
                    "transformation_config": {
                      "jexl_expression": {
                        "jexl_expression": "$s.getIpAddress()"
                      },
                      "output_type": "FIELD_TYPE_STR"
                    },
                    "transformation_configs": []
                  }
                ]
              },
              {
                "name": "user_agent",
                "type": "FIELD_TYPE_STR",
                "rules": [
                  {
                    "transformation_config": {
                      "jexl_expression": {
                        "jexl_expression": "$s.getUserAgent()"
                      },
                      "output_type": "FIELD_TYPE_STR"
                    },
                    "transformation_configs": []
                  }
                ]
              }
            ]
          },
          "target_request": {
            "generic_match_condition": {
              "jexl_expression": {
                "jexl_expression": "!($s.getPath().equals('/validate-fp'))"
              }
            },
            "negate": false
          },
          "pre_requests": [
            {
              "request_invocation_id": "validate_fp",
              "match_condition": {
                "generic_match_condition": {
                  "jexl_expression": {
                    "jexl_expression": "$s.getPath().equals('/validate-fp')"
                  }
                },
                "negate": false
              },
              "weight": 0,
              "median_percent": 0
            }
          ],
          "time_window": "300s",
          "check_for_any_pre_requests": true
        }
      },
      "rule_decision": {
        "edge_decision_type": "EDGE_DECISION_TYPE_ALERT",
        "decorations": [],
        "sampling_rate": 1,
        "threat_type": "Browser Bypass",
        "span_attributes": [],
        "edge_decision_targets": [],
        "rule_info_decorations": []
      },
      "policy_kind": "POLICY_KIND_FRAUD_PROTECTION",
      "description": ""
