      "id": "graphql_validation",
      "name": "graphql_validation",
      "version": "0",
      "rule_scope": {
        "scope_conditions": [
          {
            "url_scope": {
              "urls": [
                "/graphql"
              ]
            }
          }
        ]
      },
      "rule_category": "EDGE_DECISION_RULE_CATEGORY_ORIGINAL",
      "rule_status": {
        "disabled": false,
        "internal": false
      },
      "rule_definition": {
        "edge_input_kind": "EDGE_INPUT_KIND_HTTP_REQUEST",
        "rule_variables": [
          {
            "name": "parsed_request_gql",
            "rules": [
              {
                "transformation_config": {
                  "jexl_expression": {
                    "jexl_expression": "$s.getParsedRequestBodyGql()"
                  },
                  "output_type": "FIELD_TYPE_UNSPECIFIED"
                },
                "transformation_configs": []
              }
            ]
          }
        ],
        "attribute_projections": [],
        "signature_rule": {
          "match_condition": {
            "generic_match_condition": {
              "jexl_expression": {
                "jexl_expression": "parsed_request_gql.getNumBatches() > 10 || parsed_request_gql.getDepth() > 10 || parsed_request_gql.getNumDuplicates() > 100 || parsed_request_gql.getNumAliases() > 100 || parsed_request_gql.getQueryComplexity() > 100 || parsed_request_gql.isHasCircularReferences() || (parsed_request_gql.getSelectionSets().contains('systemHealth')) || (parsed_request_gql.getSelectionSets().contains('systemUpdate'))"
              }
            },
            "negate": false
          }
        },
        "custom_fields": {}
      },
      "rule_decision": {
        "edge_decision_type": "EDGE_DECISION_TYPE_ALERT",
        "decorations": [],
        "threat_type": "Graphql Validation",
        "span_attributes": [
          {
            "span_attribute_key": {
              "static_value": {
                "string_value": "traceableai-gql-validation-error"
              },
              "output_type": "FIELD_TYPE_UNSPECIFIED"
            },
            "span_attribute_value": {
              "jexl_expression": {
                "jexl_expression": "$s.getParsedRequestBodyGql().toSummaryString()"
              },
              "output_type": "FIELD_TYPE_UNSPECIFIED"
            }
          }
        ],
        "edge_decision_targets": [],
        "rule_info_decorations": []
      },
      "policy_kind": "POLICY_KIND_WAF",
      "description": "Default rule to be applied for graphql",
      "template_id": "Graphql validation rule"
    },
