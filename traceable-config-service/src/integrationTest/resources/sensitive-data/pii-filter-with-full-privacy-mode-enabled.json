{
  "redactionStrategy": "REDACTION_STRATEGY_REDACT",
  "prefixes": [
    "http.request.header.",
    "http.response.header.",
    "rpc.request.metadata.",
    "rpc.response.metadata."
  ],
  "keyRegexs": [
    {
      "regex": "^address",
      "category": "pii",
      "redactionStrategy": "REDACTION_STRATEGY_HASH",
      "sessionIdentifier": true,
      "ruleId": "placeholder-id"
    },
    {
      "regex": "^name",
      "category": "pii",
      "redactionStrategy": "REDACTION_STRATEGY_REDACT",
      "ruleId": "placeholder-id"
    },
    {
      "regex": "^session(\\[\\d+\\])?$",
      "category": "auth",
      "redactionStrategy": "REDACTION_STRATEGY_HASH",
      "sessionIdentifier": true,
      "ruleId": "placeholder-id"
    },
    {
      "regex": "^remember_token(\\[\\d+\\])?$",
      "category": "auth",
      "redactionStrategy": "REDACTION_STRATEGY_HASH",
      "sessionIdentifier": true,
      "ruleId": "placeholder-id"
    },
    {
      "regex": "^authorization(\\[\\d+\\])?$",
      "category": "auth",
      "redactionStrategy": "REDACTION_STRATEGY_HASH",
      "sessionIdentifier": true,
      "ruleId": "placeholder-id"
    },
    {
      "regex": "(^x-real-ip$)|(^forwarded$)|(^x-forwarded-for$)|(^x-proxy-user-ip$)",
      "category": "core_mode_default_rules",
      "redactionStrategy": "REDACTION_STRATEGY_RAW",
      "ruleId": "core_mode_rule_10",
      "conditions": [
        {
          "attributeRegexMatch": {
            "key": "traceableai.processing",
            "regex": "core"
          }
        }
      ]
    },
    {
      "regex": "^:authority$",
      "category": "core_mode_default_rules",
      "redactionStrategy": "REDACTION_STRATEGY_RAW",
      "ruleId": "core_mode_rule_9",
      "conditions": [
        {
          "attributeRegexMatch": {
            "key": "traceableai.processing",
            "regex": "core"
          }
        }
      ]
    },
    {
      "regex": "^grpc-status$",
      "category": "core_mode_default_rules",
      "redactionStrategy": "REDACTION_STRATEGY_RAW",
      "ruleId": "core_mode_rule_8",
      "conditions": [
        {
          "attributeRegexMatch": {
            "key": "traceableai.processing",
            "regex": "core"
          }
        }
      ]
    },
    {
      "regex": "^:status$",
      "category": "core_mode_default_rules",
      "redactionStrategy": "REDACTION_STRATEGY_RAW",
      "ruleId": "core_mode_rule_7",
      "conditions": [
        {
          "attributeRegexMatch": {
            "key": "traceableai.processing",
            "regex": "core"
          }
        }
      ]
    },
    {
      "regex": "^:path$",
      "category": "core_mode_default_rules",
      "redactionStrategy": "REDACTION_STRATEGY_RAW",
      "ruleId": "core_mode_rule_6",
      "conditions": [
        {
          "attributeRegexMatch": {
            "key": "traceableai.processing",
            "regex": "core"
          }
        }
      ]
    },
    {
      "regex": "^content-length$",
      "category": "core_mode_default_rules",
      "redactionStrategy": "REDACTION_STRATEGY_RAW",
      "ruleId": "core_mode_rule_5",
      "conditions": [
        {
          "attributeRegexMatch": {
            "key": "traceableai.processing",
            "regex": "core"
          }
        }
      ]
    },
    {
      "regex": "^content-type$",
      "category": "core_mode_default_rules",
      "redactionStrategy": "REDACTION_STRATEGY_RAW",
      "ruleId": "core_mode_rule_4",
      "conditions": [
        {
          "attributeRegexMatch": {
            "key": "traceableai.processing",
            "regex": "core"
          }
        }
      ]
    },
    {
      "regex": "^host$",
      "category": "core_mode_default_rules",
      "redactionStrategy": "REDACTION_STRATEGY_RAW",
      "ruleId": "core_mode_rule_3",
      "conditions": [
        {
          "attributeRegexMatch": {
            "key": "traceableai.processing",
            "regex": "core"
          }
        }
      ]
    },
    {
      "regex": "^user-agent$",
      "category": "core_mode_default_rules",
      "redactionStrategy": "REDACTION_STRATEGY_RAW",
      "ruleId": "core_mode_rule_2",
      "conditions": [
        {
          "attributeRegexMatch": {
            "key": "traceableai.processing",
            "regex": "core"
          }
        }
      ]
    },
    {
      "regex": ".*",
      "category": "core_mode_default_rules",
      "redactionStrategy": "REDACTION_STRATEGY_REDACT",
      "ruleId": "core_mode_rule_1",
      "conditions": [
        {
          "attributeRegexMatch": {
            "key": "traceableai.processing",
            "regex": "core"
          }
        }
      ]
    },
    {
      "regex": "http.request.header.h1",
      "redactionStrategy": "REDACTION_STRATEGY_HASH",
      "fqn": true
    },
    {
      "regex": "http.request.header.h2",
      "redactionStrategy": "REDACTION_STRATEGY_HASH",
      "fqn": true
    },
    {
      "regex": "^access_token(\\[\\d+\\])?$",
      "category": "auth"
    },
    {
      "regex": "^api_key(\\[\\d+\\])?$",
      "category": "auth"
    },
    {
      "regex": "^apikey(\\[\\d+\\])?$",
      "category": "auth"
    },
    {
      "regex": "^password(\\[\\d+\\])?$",
      "category": "auth"
    },
    {
      "regex": "^passwd(\\[\\d+\\])?$",
      "category": "auth"
    },
    {
      "regex": "^secret(\\[\\d+\\])?$",
      "category": "auth"
    }
  ],
  "complexData": [
    {
      "key": "http.response.header.set-cookie",
      "type": "cookie"
    },
    {
      "key": "http.request.header.cookie",
      "type": "cookie"
    },
    {
      "key": "http.response.body",
      "typeKey": "http.response.header.content-type"
    },
    {
      "key": "http.request.body",
      "typeKey": "http.request.header.content-type"
    },
    {
      "key": "rpc.response.body",
      "type": "json"
    },
    {
      "key": "rpc.request.body",
      "type": "json"
    },
    {
      "key": "sql.query",
      "type": "sql"
    },
    {
      "key": "http.url",
      "type": "urlencoded"
    }
  ]
}