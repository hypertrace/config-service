{
  "decision_rules": [{
    "id": "rate-limiting-rule-id",
    "name": "test-policy",
    "rule_scope": {
      "scope_conditions": [{
        "environment_scope": {
          "environments": ["test-env"]
        }
      }]
    },
    "rule_category": "EDGE_DECISION_RULE_CATEGORY_RATE_LIMIT",
    "rule_status": {
    },
    "rule_definition": {
      "edge_input_kind": "EDGE_INPUT_KIND_HTTP_REQUEST",
      "aggregate_threshold_rule": {
        "match_condition": {
          "logical_match_condition": {
            "operator": "LOGICAL_MATCH_OPERATOR_OR",
            "conditions": [{
              "generic_match_condition": {
                "jexl_expression": {
                  "jexl_expression": "$s.getIpIntelligenceData().getTraits().getAbuseVelocity().equals(IpAbuseVelocity.IP_ABUSE_VELOCITY_LOW)"
                }
              }
            }, {
              "generic_match_condition": {
                "jexl_expression": {
                  "jexl_expression": "$s.getIpIntelligenceData().getTraits().getAbuseVelocity().equals(IpAbuseVelocity.IP_ABUSE_VELOCITY_MEDIUM)"
                }
              }
            }, {
              "generic_match_condition": {
                "jexl_expression": {
                  "jexl_expression": "$s.getIpIntelligenceData().getTraits().getAbuseVelocity().equals(IpAbuseVelocity.IP_ABUSE_VELOCITY_HIGH)"
                }
              }
            }]
          }
        },
        "group_by_dimensions": [{
          "name": "AGGREGATE_PER_USER",
          "rules": [{
            "transformation_config": {
              "jexl_expression": {
                "jexl_expression": "USER_ATTRIBUTION_VARIABLE_NAME"
              },
              "output_type": "FIELD_TYPE_STR"
            }
          }]
        }, {
          "name": "AGGREGATE_PER_API",
          "rules": [{
            "transformation_config": {
              "jexl_expression": {
                "jexl_expression": "TRACEABLE_ENDPOINT_ID"
              },
              "output_type": "FIELD_TYPE_STR"
            }
          }]
        }],
        "time_window": "60s",
        "value_aggregate_threshold": {
          "aggregation_type": "AGGREGATION_TYPE_COUNT",
          "static_threshold": 100.0
        }
      }
    },
    "rule_decision": {
      "edge_decision_type": "EDGE_DECISION_TYPE_BLOCK"
    }
  }]
}