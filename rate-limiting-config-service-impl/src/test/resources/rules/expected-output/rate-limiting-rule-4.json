{
  "decisionRules": [{
    "id": "rate-limiting-rule-id",
    "name": "test-policy",
    "ruleScope": {
      "scopeConditions": [{
        "environmentScope": {
          "environments": ["test-env"]
        }
      }]
    },
    "ruleCategory": "EDGE_DECISION_RULE_CATEGORY_RATE_LIMIT",
    "ruleStatus": {
    },
    "ruleDefinition": {
      "edgeInputKind": "EDGE_INPUT_KIND_HTTP_REQUEST",
      "aggregateThresholdRule": {
        "matchCondition": {
          "logicalMatchCondition": {
            "operator": "LOGICAL_MATCH_OPERATOR_OR",
            "conditions": [{
              "genericMatchCondition": {
                "jexlExpression": {
                  "jexlExpression": "$s.getIpIntelligenceData().getTraits().getAbuseVelocity().equals(IpAbuseVelocity.IP_ABUSE_VELOCITY_LOW)"
                }
              }
            }, {
              "genericMatchCondition": {
                "jexlExpression": {
                  "jexlExpression": "$s.getIpIntelligenceData().getTraits().getAbuseVelocity().equals(IpAbuseVelocity.IP_ABUSE_VELOCITY_MEDIUM)"
                }
              }
            }, {
              "genericMatchCondition": {
                "jexlExpression": {
                  "jexlExpression": "$s.getIpIntelligenceData().getTraits().getAbuseVelocity().equals(IpAbuseVelocity.IP_ABUSE_VELOCITY_HIGH)"
                }
              }
            }]
          }
        },
        "groupByDimensions": [{
          "name": "AGGREGATE_PER_USER",
          "rules": [{
            "conditionExpression": {
              "jexlExpression": "TRACEABLE_USER_ID"
            }
          }]
        }, {
          "name": "AGGREGATE_PER_API",
          "rules": [{
            "conditionExpression": {
              "jexlExpression": "$s.getRequestUrl()"
            }
          }]
        }],
        "timeWindow": "60s",
        "valueAggregateThreshold": {
          "aggregationType": "AGGREGATION_TYPE_COUNT",
          "staticThreshold": 100.0
        }
      }
    },
    "ruleDecision": {
      "edgeDecisionType": "EDGE_DECISION_TYPE_BLOCK"
    }
  }]
}