{
  "decision_rules": [{
    "id": "rate-limiting-rule-id",
    "name": "test-policy",
    "rule_scope": {
      "scope_conditions": [{
        "environment_scope": {
          "environments": ["test-env"]
        }
      }]
    },
    "rule_category": "EDGE_DECISION_RULE_CATEGORY_RATE_LIMIT",
    "rule_status": {
    },
    "rule_definition": {
      "edge_input_kind": "EDGE_INPUT_KIND_HTTP_REQUEST",
      "aggregate_threshold_rule": {
        "match_condition": {
          "logical_match_condition": {
            "operator": "LOGICAL_MATCH_OPERATOR_AND",
            "conditions": [{
              "structured_match_condition": {
                "lhs": {
                  "name": "lhs",
                  "type": "FIELD_TYPE_STR",
                  "rules": [{
                    "transformation_config": {
                      "jexl_expression": {
                        "jexl_expression": "$s.getIpAddress()"
                      },
                      "output_type": "FIELD_TYPE_STR"
                    }
                  }]
                },
                "binary_operator": {
                  "list_value": ["1.2.3.4", "2.3.4.5"],
                  "match_operator": "MATCH_OPERATOR_NOT_IN"
                }
              }
            }, {
              "generic_match_condition": {
                "jexl_expression": {
                  "jexl_expression": "!(ipValidation:isIpAddressInRange(\u00273.4.5.6/24\u0027, $s.getIpAddress()))"
                }
              }
            }, {
              "generic_match_condition": {
                "jexl_expression": {
                  "jexl_expression": "!(ipValidation:isIpAddressInRange(\u00275.6.7.8/24\u0027, $s.getIpAddress()))"
                }
              }
            }]
          }
        },
        "group_by_dimensions": [{
          "name": "AGGREGATE_PER_USER",
          "rules": [{
            "transformation_config": {
              "jexl_expression": {
                "jexl_expression": "USER_ATTRIBUTION_VARIABLE_NAME"
              },
              "output_type": "FIELD_TYPE_STR"
            }
          }]
        }, {
          "name": "AGGREGATE_PER_API",
          "rules": [{
            "transformation_config": {
              "jexl_expression": {
                "jexl_expression": "TRACEABLE_ENDPOINT_ID"
              },
              "output_type": "FIELD_TYPE_STR"
            }
          }]
        }],
        "time_window": "60s",
        "value_aggregate_threshold": {
          "aggregation_type": "AGGREGATION_TYPE_COUNT",
          "static_threshold": 100.0
        }
      }
    },
    "rule_decision": {
      "edge_decision_type": "EDGE_DECISION_TYPE_BLOCK"
    }
  }]
}