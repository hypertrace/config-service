{
  "decisionRules": [{
    "id": "rate-limiting-rule-id",
    "name": "test-policy",
    "ruleScope": {
      "scopeConditions": [{
        "environmentScope": {
          "environments": ["test-env"]
        }
      }]
    },
    "ruleCategory": "EDGE_DECISION_RULE_CATEGORY_RATE_LIMIT",
    "ruleStatus": {
    },
    "ruleDefinition": {
      "edgeInputKind": "EDGE_INPUT_KIND_HTTP_REQUEST",
      "aggregateThresholdRule": {
        "matchCondition": {
          "logicalMatchCondition": {
            "operator": "LOGICAL_MATCH_OPERATOR_AND",
            "conditions": [{
              "structuredMatchCondition": {
                "lhs": {
                  "name": "lhs",
                  "type": "FIELD_TYPE_STR",
                  "rules": [{
                    "transformationConfig": {
                      "jexlExpression": {
                        "jexlExpression": "$s.getIpAddress()"
                      }
                    }
                  }]
                },
                "binaryOperator": {
                  "listValue": ["1.2.3.4", "2.3.4.5"],
                  "matchOperator": "MATCH_OPERATOR_NOT_IN"
                }
              }
            }, {
              "genericMatchCondition": {
                "jexlExpression": {
                  "jexlExpression": "!(ipValidationUtils:isIpAddressInRange(\u00273.4.5.6/24\u0027, $s.getIpAddress()))"
                }
              }
            }, {
              "genericMatchCondition": {
                "jexlExpression": {
                  "jexlExpression": "!(ipValidationUtils:isIpAddressInRange(\u00275.6.7.8/24\u0027, $s.getIpAddress()))"
                }
              }
            }]
          }
        },
        "groupByDimensions": [{
          "name": "AGGREGATE_PER_USER",
          "rules": [{
            "conditionExpression": {
              "jexlExpression": "TRACEABLE_USER_ID"
            }
          }]
        }, {
          "name": "AGGREGATE_PER_API",
          "rules": [{
            "conditionExpression": {
              "jexlExpression": "$s.getRequestUrl()"
            }
          }]
        }],
        "timeWindow": "60s",
        "valueAggregateThreshold": {
          "aggregationType": "AGGREGATION_TYPE_COUNT",
          "staticThreshold": 100.0
        }
      }
    },
    "ruleDecision": {
      "edgeDecisionType": "EDGE_DECISION_TYPE_BLOCK"
    }
  }]
}