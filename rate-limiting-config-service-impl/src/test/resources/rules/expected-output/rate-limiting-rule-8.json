{
  "decisionRules": [{
    "id": "rate-limiting-rule-id",
    "name": "test-policy",
    "ruleScope": {
      "scopeConditions": [{
        "environmentScope": {
          "environments": ["test-env"]
        }
      }]
    },
    "ruleCategory": "EDGE_DECISION_RULE_CATEGORY_RATE_LIMIT",
    "ruleStatus": {
    },
    "ruleDefinition": {
      "edgeInputKind": "EDGE_INPUT_KIND_HTTP_REQUEST",
      "aggregateThresholdRule": {
        "matchCondition": {
          "structuredMatchCondition": {
            "lhs": {
              "name": "lhs",
              "type": "FIELD_TYPE_STR",
              "rules": [{
                "transformationConfig": {
                  "jexlExpression": {
                    "jexlExpression": "$s.getIpIntelligenceData().getNetwork().getAsn()"
                  }
                }
              }]
            },
            "binaryOperator": {
              "regex": "12.*|345",
              "matchOperator": "MATCH_OPERATOR_LIKE"
            }
          }
        },
        "groupByDimensions": [{
          "name": "AGGREGATE_PER_USER",
          "rules": [{
            "conditionExpression": {
              "jexlExpression": "TRACEABLE_USER_ID"
            }
          }]
        }, {
          "name": "AGGREGATE_PER_API",
          "rules": [{
            "conditionExpression": {
              "jexlExpression":"TRACEABLE_ENDPOINT_ID"
            }
          }]
        }],
        "timeWindow": "60s",
        "valueAggregateThreshold": {
          "aggregationType": "AGGREGATION_TYPE_COUNT",
          "staticThreshold": 100.0
        }
      }
    },
    "ruleDecision": {
      "edgeDecisionType": "EDGE_DECISION_TYPE_BLOCK"
    }
  }]
}