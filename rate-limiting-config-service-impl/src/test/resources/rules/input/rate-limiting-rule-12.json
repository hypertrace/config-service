{
  "id": "rate-limiting-rule-id",
  "data": {
    "category": "CATEGORY_RATE_LIMITING",
    "name": "test-policy",
    "enabled": true,
    "ruleEvaluationPoints": ["RULE_EVALUATION_POINT_EDGE"],
    "condition": {
      "leafCondition": {
        "keyValueCondition": {
          "type": "TYPE_URL",
          "valueCondition": {
            "operator": "MATCH_OPERATOR_MATCHES_REGEX",
            "value": "https://www.abc.com/.*"
          }
        }
      }
    },
    "thresholdActionConfigs": [{
      "resourceAccessThresholdConfigs": [{
        "userAggregateType": "USER_AGGREGATE_TYPE_PER_USER",
        "apiAggregateType": "API_AGGREGATE_TYPE_PER_ENDPOINT",
        "rollingWindowThresholdConfig": {
          "countAllowed": "100",
          "durationIso": "PT1M"
        }
      }],
      "actions": [{
        "block": {
          "eventSeverity": "EVENT_SEVERITY_CRITICAL",
          "use_threshold_duration": true
        }
      }]
    }],
    "ruleConfigScope": {
      "environmentScope": {
        "environmentIds": ["test-env"]
      }
    },
    "ruleStatus": {
      "ruleCreationSource": "RULE_SOURCE_TRACEABLE"
    }
  }
