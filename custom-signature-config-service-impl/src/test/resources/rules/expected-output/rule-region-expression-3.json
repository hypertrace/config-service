      }, {
        "rule_info_key": {
          "static_value": "labels",
          "output_type": "FIELD_TYPE_STR"
        },
        "rule_info_value": {
          "static_value": "{}",
          "output_type": "FIELD_TYPE_STR"
        }
      }]
    },
    "policy_kind": "POLICY_KIND_WAF",
    "policy_id": "rule-id"
  }]
