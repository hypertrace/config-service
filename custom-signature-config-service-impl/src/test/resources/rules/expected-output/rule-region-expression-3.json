{
  "decision_rules": [{
    "id": "rule-id",
    "name": "rule-name",
    "rule_category": "EDGE_DECISION_RULE_CATEGORY_CUSTOM_SIGNATURE",
    "rule_status": {
    },
    "rule_definition": {
      "edge_input_kind": "EDGE_INPUT_KIND_HTTP_REQUEST",
      "rule_variables": [{
        "name": "region.country_iso",
        "rules": [{
          "transformation_config": {
            "jexl_expression": {
              "jexl_expression": "$s.getIpIntelligenceData().getCountry().getIsoCode()"
            },
            "output_type": "FIELD_TYPE_STR"
          }
        }]
      }, {
        "name": "region.state_name",
        "rules": [{
          "transformation_config": {
            "jexl_expression": {
              "jexl_expression": "$s.getIpIntelligenceData().getState().getName()"
            },
            "output_type": "FIELD_TYPE_STR"
          }
        }]
      }, {
        "name": "region.city_name",
        "rules": [{
          "transformation_config": {
            "jexl_expression": {
              "jexl_expression": "$s.getIpIntelligenceData().getCity().getName()"
            },
            "output_type": "FIELD_TYPE_STR"
          }
        }]
      }],
      "signature_rule": {
        "match_condition": {
          "logical_match_condition": {
            "operator": "LOGICAL_MATCH_OPERATOR_AND",
            "conditions": [{
              "logical_match_condition": {
                "operator": "LOGICAL_MATCH_OPERATOR_AND",
                "conditions": [{
                  "structured_match_condition": {
                    "lhs": {
                      "name": "region.city_name",
                      "type": "FIELD_TYPE_STR"
                    },
                    "binary_operator": {
                      "string_value": "San Francisco",
                      "match_operator": "MATCH_OPERATOR_EQ"
                    }
                  }
                }, {
                  "structured_match_condition": {
                    "lhs": {
                      "name": "region.state_name",
                      "type": "FIELD_TYPE_STR"
                    },
                    "binary_operator": {
                      "string_value": "California",
                      "match_operator": "MATCH_OPERATOR_EQ"
                    }
                  }
                }, {
                  "structured_match_condition": {
                    "lhs": {
                      "name": "region.country_iso",
                      "type": "FIELD_TYPE_STR"
                    },
                    "binary_operator": {
                      "string_value": "us",
                      "match_operator": "MATCH_OPERATOR_EQ"
                    }
                  }
                }]
              }
            }]
          }
        }
      }
    },
    "rule_decision": {
      "edge_decision_type": "EDGE_DECISION_TYPE_BLOCK",
      "rule_info_decorations": [{
        "rule_info_key": {
          "static_value": "severity",
          "output_type": "FIELD_TYPE_STR"
