{
  "id": "rule-id",
  "scope": {
    "urlMatchRegexes": ["url.*"],
    "serviceNameRegexes": ["service1.*"],
    "serviceNames": ["service2"]
  },
  "tokenRules": [{
    "tokenValueRule": {
      "valueObfuscationStrategy": "OBFUSCATION_STRATEGY_HASH",
      "tokenValueProjection": {
        "attributeProjection": {
          "valueProjectionsInOrder": [
            {
              "jsonPath": {
                "path": "$.a.b.c.d"
              }
            },{
            "regexCaptureGroup": {
              "regexCaptureGroup": "a.*bcd"
            }
          }]
        }
      }
    },
    "responseSessionTokenDetails": {
      "tokenLocation": "RESPONSE_ATTRIBUTE_KEY_LOCATION_BODY"
    }
  }]
}