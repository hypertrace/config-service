{
  "id": "rule-id",
  "scope": {
    "urlMatchRegexes": ["url.*"],
    "serviceNameRegexes": ["service1.*"]
  },
  "tokenRules": [{
    "tokenValueRule": {
      "valueObfuscationStrategy": "OBFUSCATION_STRATEGY_HASH",
      "tokenValueProjection": {
        "attributeProjection": {
          "attributeKeyMatchCondition": {
            "operator": "MATCH_OPERATOR_EQUALS",
            "matchValue": {
              "stringValue": "cookie1"
            }
          },
          "valueProjectionsInOrder": [
            {
              "jsonPath": {
                "path": "$.a.b.c.d"
              }
            },{
            "regexCaptureGroup": {
              "regexCaptureGroup": "a.*bcd"
            }
          }]
        }
      }
    },
    "requestSessionTokenDetails": {
      "tokenLocation": "REQUEST_ATTRIBUTE_KEY_LOCATION_COOKIE"
    }
  }]
}