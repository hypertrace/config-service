{
  "attribution_rules": [{
    "id": "default-jwt-auth-header-extraction",
    "rule_definition": {
      "edge_input_kind": "EDGE_INPUT_KIND_HTTP_REQUEST",
      "match_condition": {
        "structured_match_condition": {
          "lhs": {
            "name": "lhs",
            "type": "FIELD_TYPE_STR",
            "rules": [{
              "transformation_config": {
                "jexl_expression": {
                  "jexl_expression": "$s.getPath()"
                },
                "output_type": "FIELD_TYPE_STR"
              }
            }]
          },
          "unary_operator": "UNARY_OPERATOR_IS_NOT_EMPTY"
        }
      },
      "span_attributes": [{
        "span_attribute_key": {
          "static_value": "http.request.body.traceableai_jwt_iss"
        },
        "span_attribute_value": {
          "jexl_expression": {
            "jexl_expression": "traceableTransformUtils:extractJWTPath($s.getRequestHeaders().get(\u0027authorization\u0027).replaceAll(\"^(?i)Bearer\\s*:?\\s*(.*)$\", \"$1\"), \"iss\", \"PAYLOAD\")"
          }
        }
      }, {
        "span_attribute_key": {
          "static_value": "http.request.body.traceableai_jwt_aud"
        },
        "span_attribute_value": {
          "jexl_expression": {
            "jexl_expression": "traceableTransformUtils:extractJWTPath($s.getRequestHeaders().get(\u0027authorization\u0027).replaceAll(\"^(?i)Bearer\\s*:?\\s*(.*)$\", \"$1\"), \"aud\", \"PAYLOAD\")"
          }
        }
      }, {
        "span_attribute_key": {
          "static_value": "http.request.body.traceableai_jwt_exp"
        },
        "span_attribute_value": {
          "jexl_expression": {
            "jexl_expression": "traceableTransformUtils:extractJWTPath($s.getRequestHeaders().get(\u0027authorization\u0027).replaceAll(\"^(?i)Bearer\\s*:?\\s*(.*)$\", \"$1\"), \"exp\", \"PAYLOAD\")"
          }
        }
      }, {
        "span_attribute_key": {
          "static_value": "http.request.body.traceableai_jwt_nbf"
        },
        "span_attribute_value": {
          "jexl_expression": {
            "jexl_expression": "traceableTransformUtils:extractJWTPath($s.getRequestHeaders().get(\u0027authorization\u0027).replaceAll(\"^(?i)Bearer\\s*:?\\s*(.*)$\", \"$1\"), \"nbf\", \"PAYLOAD\")"
          }
        }
      }, {
        "span_attribute_key": {
          "static_value": "http.request.header.traceableai_jwt_alg"
        },
        "span_attribute_value": {
          "jexl_expression": {
            "jexl_expression": "traceableTransformUtils:extractJWTPath($s.getRequestHeaders().get(\u0027authorization\u0027).replaceAll(\"^(?i)Bearer\\s*:?\\s*(.*)$\", \"$1\"), \"alg\", \"HEADER\")"
          }
        }
      }]
    },
    "rule_status": {
    }
  }]
}