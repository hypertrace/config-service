{
  "id": "rule-id",
  "ruleInfo": {
    "name": "rule-name",
    "conditions":
    [
      {
        "attributeMatchCondition":
        {
          "keyMatchCondition": {
            "metadata": "KEY_METADATA_REQUEST_COOKIE",
            "matchCondition": {
              "operator": "MATCH_OPERATOR_MATCHES_REGEX",
              "value": "cookie.*"
            }
          },
          "valueMatchCondition": {
            "operator": "MATCH_OPERATOR_EQUALS",
            "value": "val"
          }
        }
      },
      {
        "eventCondition": {
          "customRuleEvents": [{
            "ruleFamily": "CUSTOM_RULE_FAMILY_RATE_LIMIT"
          }]
        }
      },
      {
        "conditionalExpression": {
          "operator": "LOGICAL_OPERATOR_OR",
          "expressions":
          [
            {
              "ipLocationTypeCondition": {
                "ipLocationTypes": ["IP_LOCATION_TYPE_PUBLIC_PROXY", "IP_LOCATION_TYPE_TOR_EXIT_NODE"],
                "exclude": true
              }
            },
            {
              "ipAddressCondition": {
                "ipAddresses": ["1.2.3.4", "2.3.4.5"]
              }
            },
            {
              "scopeCondition": {
                "urlScope": {
                  "urlRegexes": ["url-regex-1", "url-regex-2"]
                }
              }
            }
          ]
        }
      }
    ],
    "exclusionTargets": ["EXCLUSION_TARGET_BLOCK"]
  }
}